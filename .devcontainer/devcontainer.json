{
  "name": "Money Changer API devcontainer",
  "dockerComposeFile": "docker-compose.yml",
  "service": "dev",
  "remoteUser": "root",
  "workspaceFolder": "/workspace",
  "shutdownAction": "stopCompose",
  "runServices": ["db"],
  "forwardPorts": ["db:5432"],
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-azuretools.vscode-docker",
        "ms-ossdata.vscode-pgsql"
      ],
      "settings": {
        "pgsql.connections": [
          {
            "name": "Dev DB",
            "host": "db",
            "port": "5432",
            "database": "money_changer",
            "user": "money_changer",
            "password": "money_changer"
          }
        ]
      }
    }
  }
}
